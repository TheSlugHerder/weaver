# Weaver sample environment file
# Copy to /etc/weaver/weaver.env or similar and edit values

ENV=production
SECRET_KEY=
# NOTE: set `SECRET_KEY` in production. A temporary key will be generated in development if unset.
REQUIRE_SECRET_IN_PRODUCTION=true
REDIS_URL=redis://127.0.0.1:6379/0
MONGO_URI=mongodb://127.0.0.1:27017/weaver
JWT_LIFETIME_SECONDS=3600
ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=weaver@example.com
SMTP_USE_TLS=true

# Optional: adjust JWT lifetime (seconds)
# JWT_LIFETIME_SECONDS=3600
